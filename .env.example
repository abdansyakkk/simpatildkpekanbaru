# Copy file ini menjadi ".env" (tanpa .example) lalu isi dengan nilai asli.
# JANGAN commit file ".env" ke Git — hanya file ".env.example" ini yang boleh
# masuk ke repository.

DB_HOST=127.0.0.1
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# Generate nilai acak & kuat untuk ini, contoh lewat terminal:
#   php -r "echo bin2hex(random_bytes(32));"
ENCRYPTION_KEY=

# Set ke "production" di server live. Kosongkan / hapus baris ini
# (atau isi "development") hanya saat sedang development lokal.
CI_ENV=production
